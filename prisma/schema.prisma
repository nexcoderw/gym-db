generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING   @map("pending")
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")

  @@map("user_status")
}

enum PlatformStaffStatus {
  PENDING   @map("pending")
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  REVOKED   @map("revoked")

  @@map("platform_staff_status")
}

enum OrganizationStatus {
  PENDING   @map("pending")
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  ARCHIVED  @map("archived")

  @@map("organization_status")
}

enum OrganizationAuditAction {
  CREATE   @map("create")
  UPDATE   @map("update")
  ACTIVATE @map("activate")
  SUSPEND  @map("suspend")

  @@map("organization_audit_action")
}

enum PlatformAuthorizationAuditAction {
  PROVISION_ORGANIZATION_MANAGER @map("provision_organization_manager")

  @@map("platform_authorization_audit_action")
}

enum PlatformAuthorizationAuditOutcome {
  GRANTED         @map("granted")
  ALREADY_GRANTED @map("already_granted")

  @@map("platform_authorization_audit_outcome")
}

/// Platform-managed tenant root, not a tenant-owned child or an authorization grant.
/// Slug grammar, reserved names and nonblank names require reviewed SQL CHECK constraints.
/// Lifecycle timestamps record the latest corresponding transition; status remains authoritative.
model Organization {
  id          String                   @id(map: "organizations_pkey") @default(uuid()) @db.Uuid
  name        String                   @db.VarChar(160)
  slug        String                   @unique(map: "organizations_slug_key") @db.VarChar(63)
  status      OrganizationStatus       @default(PENDING)
  activatedAt DateTime?                @map("activated_at") @db.Timestamptz(6)
  suspendedAt DateTime?                @map("suspended_at") @db.Timestamptz(6)
  archivedAt  DateTime?                @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  auditEvents OrganizationAuditEvent[]

  @@index([status, createdAt(sort: Desc), id], map: "organizations_status_created_at_id_idx")
  @@map("organizations")
}

/// Global login identity. An account has no platform privileges without an active PlatformStaff
/// record and permissions obtained through explicit role assignments.
model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique(map: "users_email_key") @db.Citext
  displayName        String              @map("display_name") @db.VarChar(160)
  status             UserStatus          @default(PENDING)
  emailVerifiedAt    DateTime?           @map("email_verified_at") @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  passwordCredential PasswordCredential?
  platformStaff      PlatformStaff?

  @@index([status], map: "users_status_idx")
  @@map("users")
}

/// Password material is deliberately separated from public identity data. Values must be hashes
/// produced by an approved application-layer password hashing algorithm, never plaintext.
model PasswordCredential {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique(map: "password_credentials_user_id_key") @map("user_id") @db.Uuid
  passwordHash      String   @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("password_credentials")
}

/// Explicit eligibility for NEXCODE platform administration. Active status alone grants nothing;
/// authorization also requires effective permissions assigned through PlatformRole.
model PlatformStaff {
  id                       String                            @id @default(uuid()) @db.Uuid
  userId                   String                            @unique(map: "platform_staff_user_id_key") @map("user_id") @db.Uuid
  status                   PlatformStaffStatus
  suspendedAt              DateTime?                         @map("suspended_at") @db.Timestamptz(6)
  createdAt                DateTime                          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                          @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                     User                              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  roles                    PlatformStaffRole[]
  adminSessions            PlatformAdminSession[]
  totpCredential           PlatformTotpCredential?
  recoveryCodes            PlatformRecoveryCode[]
  mfaChallenges            PlatformMfaChallenge[]
  organizationAuditEvents  OrganizationAuditEvent[]
  authorizationAuditEvents PlatformAuthorizationAuditEvent[]

  @@index([status], map: "platform_staff_status_idx")
  @@map("platform_staff")
}

/// Server-side NEXCODE administration session. Only a digest of the high-entropy token is stored,
/// and the required MFA timestamp prevents this record from representing a pre-MFA login state.
model PlatformAdminSession {
  id              String        @id @default(uuid()) @db.Uuid
  platformStaffId String        @map("platform_staff_id") @db.Uuid
  tokenDigest     String        @unique(map: "platform_admin_sessions_token_digest_key") @map("token_digest") @db.VarChar(128)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz(6)
  idleExpiresAt   DateTime      @map("idle_expires_at") @db.Timestamptz(6)
  lastSeenAt      DateTime      @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  mfaVerifiedAt   DateTime      @map("mfa_verified_at") @db.Timestamptz(6)
  revokedAt       DateTime?     @map("revoked_at") @db.Timestamptz(6)
  platformStaff   PlatformStaff @relation(fields: [platformStaffId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([platformStaffId, revokedAt, expiresAt], map: "platform_admin_sessions_staff_active_idx")
  @@index([expiresAt], map: "platform_admin_sessions_expires_at_idx")
  @@index([idleExpiresAt], map: "platform_admin_sessions_idle_expires_at_idx")
  @@map("platform_admin_sessions")
}

/// Encrypted TOTP factor for one platform staff identity. Encryption and authenticated-decryption
/// keys remain outside PostgreSQL; the API must atomically advance the accepted time step.
model PlatformTotpCredential {
  id                   String        @id @default(uuid()) @db.Uuid
  platformStaffId      String        @unique(map: "platform_totp_credentials_staff_key") @map("platform_staff_id") @db.Uuid
  encryptedSecret      Bytes         @map("encrypted_secret") @db.ByteA
  encryptionKeyId      String        @map("encryption_key_id") @db.VarChar(120)
  encryptionVersion    Int           @default(1) @map("encryption_version")
  initializationVector Bytes         @map("initialization_vector") @db.ByteA
  authenticationTag    Bytes         @map("authentication_tag") @db.ByteA
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  verifiedAt           DateTime?     @map("verified_at") @db.Timestamptz(6)
  lastUsedAt           DateTime?     @map("last_used_at") @db.Timestamptz(6)
  lastAcceptedTimeStep BigInt?       @map("last_accepted_time_step") @db.BigInt
  disabledAt           DateTime?     @map("disabled_at") @db.Timestamptz(6)
  platformStaff        PlatformStaff @relation(fields: [platformStaffId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("platform_totp_credentials")
}

/// Single-use platform MFA recovery material. The API generates high-entropy codes and stores only
/// their cryptographic digests; consumption must use a conditional atomic update on `usedAt`.
model PlatformRecoveryCode {
  id              String        @id @default(uuid()) @db.Uuid
  platformStaffId String        @map("platform_staff_id") @db.Uuid
  codeDigest      String        @unique(map: "platform_recovery_codes_digest_key") @map("code_digest") @db.VarChar(128)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  usedAt          DateTime?     @map("used_at") @db.Timestamptz(6)
  platformStaff   PlatformStaff @relation(fields: [platformStaffId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([platformStaffId, usedAt], map: "platform_recovery_codes_staff_unused_idx")
  @@map("platform_recovery_codes")
}

/// Short-lived pre-authentication MFA challenge. It grants no platform access and can become a
/// session only through an authorized API flow after expiry, consumption, and attempt checks.
model PlatformMfaChallenge {
  id                String        @id @default(uuid()) @db.Uuid
  platformStaffId   String        @map("platform_staff_id") @db.Uuid
  tokenDigest       String        @unique(map: "platform_mfa_challenges_token_digest_key") @map("token_digest") @db.VarChar(128)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt         DateTime      @map("expires_at") @db.Timestamptz(6)
  consumedAt        DateTime?     @map("consumed_at") @db.Timestamptz(6)
  failedAttempts    Int           @default(0) @map("failed_attempts")
  maxAttempts       Int           @default(5) @map("max_attempts")
  /// Keyed digest scoped to this challenge and verified recipient; never store the plaintext OTP.
  emailOtpDigest    String?       @map("email_otp_digest") @db.VarChar(128)
  emailOtpExpiresAt DateTime?     @map("email_otp_expires_at") @db.Timestamptz(6)
  emailOtpSentAt    DateTime?     @map("email_otp_sent_at") @db.Timestamptz(6)
  emailOtpSendCount Int           @default(0) @map("email_otp_send_count")
  platformStaff     PlatformStaff @relation(fields: [platformStaffId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([platformStaffId, consumedAt, expiresAt], map: "platform_mfa_challenges_staff_active_idx")
  @@index([expiresAt], map: "platform_mfa_challenges_expires_at_idx")
  @@map("platform_mfa_challenges")
}

model PlatformRole {
  id                       String                            @id @default(uuid()) @db.Uuid
  key                      String                            @unique(map: "platform_roles_key_key") @db.Citext
  name                     String                            @db.VarChar(120)
  description              String                            @db.VarChar(500)
  isSystem                 Boolean                           @default(false) @map("is_system")
  createdAt                DateTime                          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                          @updatedAt @map("updated_at") @db.Timestamptz(6)
  staff                    PlatformStaffRole[]
  permissions              PlatformRolePermission[]
  authorizationAuditEvents PlatformAuthorizationAuditEvent[]

  @@map("platform_roles")
}

model PlatformPermission {
  id          String                   @id @default(uuid()) @db.Uuid
  key         String                   @unique(map: "platform_permissions_key_key") @db.Citext
  description String                   @db.VarChar(500)
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles       PlatformRolePermission[]

  @@map("platform_permissions")
}

model PlatformStaffRole {
  platformStaffId String        @map("platform_staff_id") @db.Uuid
  platformRoleId  String        @map("platform_role_id") @db.Uuid
  assignedAt      DateTime      @default(now()) @map("assigned_at") @db.Timestamptz(6)
  platformStaff   PlatformStaff @relation(fields: [platformStaffId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  platformRole    PlatformRole  @relation(fields: [platformRoleId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([platformStaffId, platformRoleId], map: "platform_staff_roles_pkey")
  @@index([platformRoleId], map: "platform_staff_roles_role_id_idx")
  @@map("platform_staff_roles")
}

model PlatformRolePermission {
  platformRoleId       String             @map("platform_role_id") @db.Uuid
  platformPermissionId String             @map("platform_permission_id") @db.Uuid
  grantedAt            DateTime           @default(now()) @map("granted_at") @db.Timestamptz(6)
  platformRole         PlatformRole       @relation(fields: [platformRoleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  platformPermission   PlatformPermission @relation(fields: [platformPermissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([platformRoleId, platformPermissionId], map: "platform_role_permissions_pkey")
  @@index([platformPermissionId], map: "platform_role_permissions_permission_id_idx")
  @@map("platform_role_permissions")
}

/// Successful platform mutations only. SQL checks enforce action-specific metadata; reviewed
/// grants deny routine UPDATE/DELETE. Restrictive references intentionally block parent deletion.
/// A reviewed BEFORE INSERT trigger controls recordedAt even when a writer supplies a value.
model OrganizationAuditEvent {
  id                   String                  @id(map: "organization_audit_events_pkey") @default(uuid()) @db.Uuid
  organizationId       String                  @map("organization_id") @db.Uuid
  actorPlatformStaffId String                  @map("actor_platform_staff_id") @db.Uuid
  requestId            String                  @map("request_id") @db.VarChar(128)
  action               OrganizationAuditAction
  previousStatus       OrganizationStatus?     @map("previous_status")
  resultingStatus      OrganizationStatus      @map("resulting_status")
  changedFields        String[]                @map("changed_fields") @db.VarChar(32)
  previousName         String?                 @map("previous_name") @db.VarChar(160)
  resultingName        String?                 @map("resulting_name") @db.VarChar(160)
  occurredAt           DateTime                @map("occurred_at") @db.Timestamptz(6)
  recordedAt           DateTime                @default(now()) @map("recorded_at") @db.Timestamptz(6)
  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "organization_audit_events_organization_fkey")
  actorPlatformStaff   PlatformStaff           @relation(fields: [actorPlatformStaffId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "organization_audit_events_actor_fkey")

  @@index([organizationId, recordedAt(sort: Desc), id], map: "organization_audit_events_organization_time_idx")
  @@index([actorPlatformStaffId, recordedAt(sort: Desc), id], map: "organization_audit_events_actor_time_idx")
  @@index([recordedAt, id], map: "organization_audit_events_recorded_time_idx")
  @@index([requestId], map: "organization_audit_events_request_idx")
  @@map("organization_audit_events")
}

/// Narrow audit for approved organization-manager provisioning, not arbitrary authorization JSON.
/// The INSERT trigger derives database/operator identities from the actual connection, not input.
/// grantedPermissionKeys is empty only when the exact assignment already exists; no failed grant
/// is recorded as committed success. Role/staff deletion is restricted while history references it.
model PlatformAuthorizationAuditEvent {
  id                     String                            @id(map: "platform_authorization_audit_events_pkey") @default(uuid()) @db.Uuid
  action                 PlatformAuthorizationAuditAction
  targetPlatformStaffId  String                            @map("target_platform_staff_id") @db.Uuid
  targetPlatformRoleId   String                            @map("target_platform_role_id") @db.Uuid
  approvedPermissionKeys String[]                          @map("approved_permission_keys") @db.VarChar(80)
  grantedPermissionKeys  String[]                          @map("granted_permission_keys") @db.VarChar(80)
  operatorSessionRole    String                            @default(dbgenerated("SESSION_USER")) @map("operator_session_role") @db.VarChar(63)
  operatorDatabaseRole   String                            @default(dbgenerated("CURRENT_USER")) @map("operator_database_role") @db.VarChar(63)
  databaseName           String                            @default(dbgenerated("CURRENT_DATABASE()")) @map("database_name") @db.VarChar(63)
  approvalReference      String                            @map("approval_reference") @db.VarChar(120)
  correlationId          String                            @map("correlation_id") @db.Uuid
  outcome                PlatformAuthorizationAuditOutcome
  occurredAt             DateTime                          @map("occurred_at") @db.Timestamptz(6)
  recordedAt             DateTime                          @default(now()) @map("recorded_at") @db.Timestamptz(6)
  targetPlatformStaff    PlatformStaff                     @relation(fields: [targetPlatformStaffId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "platform_authorization_audit_events_staff_fkey")
  targetPlatformRole     PlatformRole                      @relation(fields: [targetPlatformRoleId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "platform_authorization_audit_events_role_fkey")

  @@index([targetPlatformStaffId, recordedAt(sort: Desc), id], map: "platform_authorization_audit_events_staff_time_idx")
  @@index([targetPlatformRoleId, recordedAt(sort: Desc), id], map: "platform_authorization_audit_events_role_time_idx")
  @@index([recordedAt, id], map: "platform_authorization_audit_events_recorded_time_idx")
  @@index([correlationId], map: "platform_authorization_audit_events_correlation_idx")
  @@map("platform_authorization_audit_events")
}
