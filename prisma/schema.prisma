generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING   @map("pending")
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")

  @@map("user_status")
}

enum OwnerSessionAssurance {
  AAL1 @map("aal1")
  AAL2 @map("aal2")

  @@map("owner_session_assurance")
}

enum PlatformStaffStatus {
  PENDING   @map("pending")
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  REVOKED   @map("revoked")

  @@map("platform_staff_status")
}

enum OrganizationStatus {
  PENDING   @map("pending")
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  ARCHIVED  @map("archived")

  @@map("organization_status")
}

enum OrganizationMembershipStatus {
  PENDING   @map("pending")
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  REVOKED   @map("revoked")

  @@map("organization_membership_status")
}

enum OrganizationOwnerInvitationStatus {
  PENDING_DELIVERY @map("pending_delivery")
  SENT             @map("sent")
  ACCEPTED         @map("accepted")
  REVOKED          @map("revoked")

  @@map("organization_owner_invitation_status")
}

enum OrganizationOwnerInvitationDeliveryStatus {
  QUEUED     @map("queued")
  PROCESSING @map("processing")
  CONFIRMED  @map("confirmed")
  FAILED     @map("failed")
  UNCERTAIN  @map("uncertain")

  @@map("organization_owner_invitation_delivery_status")
}

enum OrganizationOwnershipAuditAction {
  INVITATION_CREATED         @map("invitation_created")
  INVITATION_REVOKED         @map("invitation_revoked")
  INVITATION_DELIVERY_QUEUED @map("invitation_delivery_queued")

  @@map("organization_ownership_audit_action")
}

enum OrganizationOwnerEnrollmentPurpose {
  NEW_USER_ENROLLMENT          @map("new_user_enrollment")
  EXISTING_USER_AUTHENTICATION @map("existing_user_authentication")

  @@map("organization_owner_enrollment_purpose")
}

enum OrganizationOwnerEnrollmentStatus {
  PENDING  @map("pending")
  VERIFIED @map("verified")
  CONSUMED @map("consumed")
  REVOKED  @map("revoked")

  @@map("organization_owner_enrollment_status")
}

enum OrganizationOwnerAcceptanceAuditAction {
  OWNER_INVITATION_ACCEPTED @map("owner_invitation_accepted")

  @@map("organization_owner_acceptance_audit_action")
}

enum OrganizationAuditAction {
  CREATE   @map("create")
  UPDATE   @map("update")
  ACTIVATE @map("activate")
  SUSPEND  @map("suspend")
  ARCHIVE  @map("archive")

  @@map("organization_audit_action")
}

enum PlatformAuthorizationAuditAction {
  PROVISION_ORGANIZATION_MANAGER @map("provision_organization_manager")

  @@map("platform_authorization_audit_action")
}

enum PlatformAuthorizationAuditOutcome {
  GRANTED         @map("granted")
  ALREADY_GRANTED @map("already_granted")

  @@map("platform_authorization_audit_outcome")
}

/// Platform-managed tenant root, not a tenant-owned child or an authorization grant.
/// Slug grammar, reserved names and nonblank names require reviewed SQL CHECK constraints.
/// Lifecycle timestamps record the latest corresponding transition; status remains authoritative.
model Organization {
  id                         String                                  @id(map: "organizations_pkey") @default(uuid()) @db.Uuid
  name                       String                                  @db.VarChar(160)
  slug                       String                                  @unique(map: "organizations_slug_key") @db.VarChar(63)
  status                     OrganizationStatus                      @default(PENDING)
  activatedAt                DateTime?                               @map("activated_at") @db.Timestamptz(6)
  suspendedAt                DateTime?                               @map("suspended_at") @db.Timestamptz(6)
  archivedAt                 DateTime?                               @map("archived_at") @db.Timestamptz(6)
  createdAt                  DateTime                                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                                @updatedAt @map("updated_at") @db.Timestamptz(6)
  auditEvents                OrganizationAuditEvent[]
  memberships                OrganizationMembership[]
  roles                      OrganizationRole[]
  ownerInvitations           OrganizationOwnerInvitation[]
  ownerInvitationDeliveries  OrganizationOwnerInvitationDelivery[]
  ownershipAuditEvents       OrganizationOwnershipAuditEvent[]
  ownerEnrollmentChallenges  OrganizationOwnerEnrollmentChallenge[]
  ownerAcceptanceAuditEvents OrganizationOwnerAcceptanceAuditEvent[]

  @@index([status, createdAt(sort: Desc), id], map: "organizations_status_created_at_id_idx")
  @@map("organizations")
}

/// Global login identity. An account has no platform privileges without an active PlatformStaff
/// record and permissions obtained through explicit role assignments.
model User {
  id                         String                                  @id @default(uuid()) @db.Uuid
  email                      String                                  @unique(map: "users_email_key") @db.Citext
  displayName                String                                  @map("display_name") @db.VarChar(160)
  status                     UserStatus                              @default(PENDING)
  emailVerifiedAt            DateTime?                               @map("email_verified_at") @db.Timestamptz(6)
  createdAt                  DateTime                                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                                @updatedAt @map("updated_at") @db.Timestamptz(6)
  passwordCredential         PasswordCredential?
  platformStaff              PlatformStaff?
  organizationMemberships    OrganizationMembership[]
  ownerEnrollmentChallenges  OrganizationOwnerEnrollmentChallenge[]
  ownerAcceptanceAuditEvents OrganizationOwnerAcceptanceAuditEvent[]
  ownerSessions              OwnerSession[]

  @@index([status], map: "users_status_idx")
  @@map("users")
}

/// Organization-scoped authorization eligibility for one global User. Status is authoritative;
/// lifecycle timestamps are metadata and do not independently grant access. A revoked identity
/// remains unique so rejoining requires an explicitly reviewed workflow.
model OrganizationMembership {
  id                         String                                  @id(map: "organization_memberships_pkey") @default(uuid()) @db.Uuid
  organizationId             String                                  @map("organization_id") @db.Uuid
  userId                     String                                  @map("user_id") @db.Uuid
  status                     OrganizationMembershipStatus            @default(PENDING)
  createdAt                  DateTime                                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                                @updatedAt @map("updated_at") @db.Timestamptz(6)
  activatedAt                DateTime?                               @map("activated_at") @db.Timestamptz(6)
  suspendedAt                DateTime?                               @map("suspended_at") @db.Timestamptz(6)
  revokedAt                  DateTime?                               @map("revoked_at") @db.Timestamptz(6)
  organization               Organization                            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "organization_memberships_organization_fkey")
  user                       User                                    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "organization_memberships_user_fkey")
  roles                      OrganizationMembershipRole[]
  ownerAcceptanceAuditEvents OrganizationOwnerAcceptanceAuditEvent[]

  @@unique([organizationId, userId], map: "organization_memberships_organization_user_key")
  @@unique([organizationId, id], map: "organization_memberships_organization_id_key")
  @@unique([organizationId, id, userId], map: "organization_memberships_org_id_user_key")
  @@index([organizationId, status, createdAt(sort: Desc), id], map: "organization_memberships_org_status_created_id_idx")
  @@index([organizationId, createdAt(sort: Desc), id], map: "organization_memberships_org_created_id_idx")
  @@index([userId, status, createdAt(sort: Desc), id], map: "organization_memberships_user_status_created_id_idx")
  @@map("organization_memberships")
}

/// A role definition owned by exactly one Organization. `isSystem` records trusted provisioning
/// policy but grants nothing by itself; SQL CHECK constraints reserve the `owner` key against custom
/// role impersonation and validate bounded lowercase role identifiers.
model OrganizationRole {
  id             String                       @id(map: "organization_roles_pkey") @default(uuid()) @db.Uuid
  organizationId String                       @map("organization_id") @db.Uuid
  key            String                       @db.VarChar(63)
  name           String                       @db.VarChar(120)
  description    String?                      @db.VarChar(500)
  isSystem       Boolean                      @default(false) @map("is_system")
  createdAt      DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "organization_roles_organization_fkey")
  memberships    OrganizationMembershipRole[]

  @@unique([organizationId, key], map: "organization_roles_organization_key_key")
  @@unique([organizationId, id], map: "organization_roles_organization_id_key")
  @@index([organizationId, isSystem, createdAt(sort: Desc), id], map: "organization_roles_org_system_created_id_idx")
  @@map("organization_roles")
}

/// Same-organization composite foreign keys make cross-tenant membership/role assignments
/// impossible even when a caller supplies individually valid global UUIDs.
model OrganizationMembershipRole {
  organizationId           String                 @map("organization_id") @db.Uuid
  organizationMembershipId String                 @map("organization_membership_id") @db.Uuid
  organizationRoleId       String                 @map("organization_role_id") @db.Uuid
  assignedAt               DateTime               @default(now()) @map("assigned_at") @db.Timestamptz(6)
  organizationMembership   OrganizationMembership @relation(fields: [organizationId, organizationMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "organization_membership_roles_membership_fkey")
  organizationRole         OrganizationRole       @relation(fields: [organizationId, organizationRoleId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "organization_membership_roles_role_fkey")

  @@id([organizationId, organizationMembershipId, organizationRoleId], map: "organization_membership_roles_pkey")
  @@index([organizationId, organizationRoleId, organizationMembershipId], map: "organization_membership_roles_org_role_membership_idx")
  @@map("organization_membership_roles")
}

/// A platform-authorized offer to begin owner onboarding. This record grants no membership,
/// tenant role, verified identity, credentials, session or platform permission. Email is retained
/// independently until a future verified acceptance workflow securely binds it to a User.
model OrganizationOwnerInvitation {
  id                       String                                 @id(map: "organization_owner_invitations_pkey") @default(uuid()) @db.Uuid
  organizationId           String                                 @map("organization_id") @db.Uuid
  invitedEmail             String                                 @map("invited_email") @db.Citext
  invitedDisplayName       String                                 @map("invited_display_name") @db.VarChar(160)
  invitedByPlatformStaffId String                                 @map("invited_by_platform_staff_id") @db.Uuid
  status                   OrganizationOwnerInvitationStatus      @default(PENDING_DELIVERY)
  tokenDigest              String?                                @unique(map: "organization_owner_invitations_token_digest_key") @map("token_digest") @db.VarChar(128)
  expiresAt                DateTime?                              @map("expires_at") @db.Timestamptz(6)
  sentAt                   DateTime?                              @map("sent_at") @db.Timestamptz(6)
  acceptedAt               DateTime?                              @map("accepted_at") @db.Timestamptz(6)
  revokedAt                DateTime?                              @map("revoked_at") @db.Timestamptz(6)
  createdAt                DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization             Organization                           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "organization_owner_invitations_organization_fkey")
  invitedByPlatformStaff   PlatformStaff                          @relation(fields: [invitedByPlatformStaffId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "organization_owner_invitations_actor_fkey")
  auditEvents              OrganizationOwnershipAuditEvent[]
  delivery                 OrganizationOwnerInvitationDelivery?
  enrollmentChallenges     OrganizationOwnerEnrollmentChallenge[]
  acceptanceAudit          OrganizationOwnerAcceptanceAuditEvent?

  @@unique([organizationId, id], map: "organization_owner_invitations_organization_id_key")
  @@index([organizationId, status, createdAt(sort: Desc), id], map: "organization_owner_invitations_org_status_created_id_idx")
  @@index([organizationId, invitedEmail, createdAt(sort: Desc), id], map: "organization_owner_invitations_org_email_created_id_idx")
  @@index([organizationId, invitedByPlatformStaffId, createdAt(sort: Desc), id], map: "organization_owner_invitations_org_actor_created_id_idx")
  @@map("organization_owner_invitations")
}

/// Short-lived owner-enrollment proof only. Server-side identity verification resolves userId;
/// neither invitation possession nor a persisted status alone authenticates a recipient.
/// Reviewed SQL must enforce proof lifecycle, monotonic attempts, expiry and single consumption.
model OrganizationOwnerEnrollmentChallenge {
  id                    String                                  @id(map: "owner_enrollment_challenges_pkey") @default(uuid()) @db.Uuid
  organizationId        String                                  @map("organization_id") @db.Uuid
  ownerInvitationId     String                                  @map("owner_invitation_id") @db.Uuid
  userId                String?                                 @map("user_id") @db.Uuid
  purpose               OrganizationOwnerEnrollmentPurpose
  status                OrganizationOwnerEnrollmentStatus       @default(PENDING)
  tokenDigest           String?                                 @unique(map: "owner_enrollment_challenges_token_digest_key") @map("token_digest") @db.VarChar(128)
  failedAttempts        Int                                     @default(0) @map("failed_attempts")
  maxAttempts           Int                                     @default(5) @map("max_attempts")
  createdAt             DateTime                                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                                @updatedAt @map("updated_at") @db.Timestamptz(6)
  expiresAt             DateTime                                @map("expires_at") @db.Timestamptz(6)
  mailboxVerifiedAt     DateTime?                               @map("mailbox_verified_at") @db.Timestamptz(6)
  authenticatedAt       DateTime?                               @map("authenticated_at") @db.Timestamptz(6)
  stepUpVerifiedAt      DateTime?                               @map("step_up_verified_at") @db.Timestamptz(6)
  verifiedAt            DateTime?                               @map("verified_at") @db.Timestamptz(6)
  consumedAt            DateTime?                               @map("consumed_at") @db.Timestamptz(6)
  revokedAt             DateTime?                               @map("revoked_at") @db.Timestamptz(6)
  organization          Organization                            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "owner_enrollment_challenges_organization_fkey")
  ownerInvitation       OrganizationOwnerInvitation             @relation(fields: [organizationId, ownerInvitationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "owner_enrollment_challenges_invitation_fkey")
  user                  User?                                   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "owner_enrollment_challenges_user_fkey")
  acceptanceAuditEvents OrganizationOwnerAcceptanceAuditEvent[]

  @@unique([organizationId, id, ownerInvitationId, userId], map: "owner_enrollment_challenges_proof_identity_key")
  @@index([organizationId, ownerInvitationId, status, expiresAt, id], map: "owner_enrollment_challenges_org_invitation_status_idx")
  @@index([organizationId, userId, createdAt(sort: Desc), id], map: "owner_enrollment_challenges_org_user_created_idx")
  @@index([expiresAt, id], map: "owner_enrollment_challenges_expiry_idx")
  @@map("organization_owner_enrollment_challenges")
}

/// Recipient-actor acceptance history, separate from administrator invitation-management audits.
/// Composite references bind the invitation, consumed proof and membership to the same gym/User.
/// Reviewed SQL stamps recordedAt; normal runtime privileges permit only SELECT and INSERT.
model OrganizationOwnerAcceptanceAuditEvent {
  id                       String                                 @id(map: "owner_acceptance_audit_events_pkey") @default(uuid()) @db.Uuid
  organizationId           String                                 @map("organization_id") @db.Uuid
  ownerInvitationId        String                                 @map("owner_invitation_id") @db.Uuid
  enrollmentChallengeId    String                                 @map("enrollment_challenge_id") @db.Uuid
  actorUserId              String                                 @map("actor_user_id") @db.Uuid
  organizationMembershipId String                                 @map("organization_membership_id") @db.Uuid
  action                   OrganizationOwnerAcceptanceAuditAction @default(OWNER_INVITATION_ACCEPTED)
  requestId                String                                 @map("request_id") @db.VarChar(128)
  occurredAt               DateTime                               @map("occurred_at") @db.Timestamptz(6)
  recordedAt               DateTime                               @default(now()) @map("recorded_at") @db.Timestamptz(6)
  organization             Organization                           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "owner_acceptance_audit_events_organization_fkey")
  ownerInvitation          OrganizationOwnerInvitation            @relation(fields: [organizationId, ownerInvitationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "owner_acceptance_audit_events_invitation_fkey")
  actorUser                User                                   @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "owner_acceptance_audit_events_user_fkey")
  organizationMembership   OrganizationMembership                 @relation(fields: [organizationId, organizationMembershipId, actorUserId], references: [organizationId, id, userId], onDelete: Restrict, onUpdate: Restrict, map: "owner_acceptance_audit_events_membership_fkey")
  enrollmentChallenge      OrganizationOwnerEnrollmentChallenge   @relation(fields: [organizationId, enrollmentChallengeId, ownerInvitationId, actorUserId], references: [organizationId, id, ownerInvitationId, userId], onDelete: Restrict, onUpdate: Restrict, map: "owner_acceptance_audit_events_challenge_fkey")

  @@unique([organizationId, ownerInvitationId], map: "owner_acceptance_audit_events_org_invitation_key")
  @@index([organizationId, actorUserId, recordedAt(sort: Desc), id], map: "owner_acceptance_audit_events_org_actor_time_idx")
  @@index([organizationId, organizationMembershipId, recordedAt(sort: Desc), id], map: "owner_acceptance_audit_events_org_membership_time_idx")
  @@index([requestId], map: "owner_acceptance_audit_events_request_idx")
  @@map("organization_owner_acceptance_audit_events")
}

/// Durable delivery reservation for one owner invitation. A row records administrator-authorized
/// preparation and worker/provider outcomes; it grants no identity, membership, role or session.
/// Ciphertext is authenticated, purpose-bound token material and must be erased after terminal use.
model OrganizationOwnerInvitationDelivery {
  id                         String                                    @id(map: "organization_owner_invitation_deliveries_pkey") @default(uuid()) @db.Uuid
  organizationId             String                                    @map("organization_id") @db.Uuid
  ownerInvitationId          String                                    @map("owner_invitation_id") @db.Uuid
  requestedByPlatformStaffId String                                    @map("requested_by_platform_staff_id") @db.Uuid
  status                     OrganizationOwnerInvitationDeliveryStatus @default(QUEUED)
  attemptCount               Int                                       @default(0) @map("attempt_count")
  maxAttempts                Int                                       @default(3) @map("max_attempts")
  nextAttemptAt              DateTime?                                 @map("next_attempt_at") @db.Timestamptz(6)
  leaseAcquiredAt            DateTime?                                 @map("lease_acquired_at") @db.Timestamptz(6)
  leaseExpiresAt             DateTime?                                 @map("lease_expires_at") @db.Timestamptz(6)
  claimedBy                  String?                                   @map("claimed_by") @db.VarChar(120)
  providerIdempotencyKey     String                                    @unique(map: "owner_invitation_deliveries_provider_idempotency_key") @map("provider_idempotency_key") @db.VarChar(128)
  providerMessageId          String?                                   @unique(map: "owner_invitation_deliveries_provider_message_id_key") @map("provider_message_id") @db.VarChar(128)
  lastErrorCode              String?                                   @map("last_error_code") @db.VarChar(63)
  tokenDigest                String?                                   @unique(map: "organization_owner_invitation_deliveries_token_digest_key") @map("token_digest") @db.VarChar(128)
  tokenCiphertext            Bytes?                                    @map("token_ciphertext")
  tokenInitializationVector  Bytes?                                    @map("token_initialization_vector")
  tokenAuthenticationTag     Bytes?                                    @map("token_authentication_tag")
  tokenEncryptionKeyId       String?                                   @map("token_encryption_key_id") @db.VarChar(120)
  tokenEncryptionVersion     Int?                                      @map("token_encryption_version")
  tokenExpiresAt             DateTime                                  @map("token_expires_at") @db.Timestamptz(6)
  confirmedAt                DateTime?                                 @map("confirmed_at") @db.Timestamptz(6)
  failedAt                   DateTime?                                 @map("failed_at") @db.Timestamptz(6)
  uncertainAt                DateTime?                                 @map("uncertain_at") @db.Timestamptz(6)
  tokenErasedAt              DateTime?                                 @map("token_erased_at") @db.Timestamptz(6)
  createdAt                  DateTime                                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization               Organization                              @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "organization_owner_invitation_deliveries_organization_fkey")
  ownerInvitation            OrganizationOwnerInvitation               @relation(fields: [organizationId, ownerInvitationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "organization_owner_invitation_deliveries_invitation_fkey")
  requestedByPlatformStaff   PlatformStaff                             @relation(fields: [requestedByPlatformStaffId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "organization_owner_invitation_deliveries_actor_fkey")

  @@unique([organizationId, id], map: "organization_owner_invitation_deliveries_organization_id_key")
  @@unique([organizationId, ownerInvitationId], map: "owner_invitation_deliveries_org_invitation_key")
  @@index([organizationId, status, nextAttemptAt, id], map: "organization_owner_invitation_deliveries_org_status_next_id_idx")
  @@index([organizationId, requestedByPlatformStaffId, createdAt(sort: Desc), id], map: "owner_invitation_deliveries_org_actor_created_id_idx")
  @@index([status, nextAttemptAt, leaseExpiresAt, id], map: "organization_owner_invitation_deliveries_worker_claim_idx")
  @@map("organization_owner_invitation_deliveries")
}

/// Successful owner-invitation mutations only. Action-specific SQL checks constrain metadata,
/// database triggers control recordedAt and reviewed runtime grants make this append-only for the
/// normal application role. No token, credential or raw request content belongs in this record.
model OrganizationOwnershipAuditEvent {
  id                        String                             @id(map: "organization_ownership_audit_events_pkey") @default(uuid()) @db.Uuid
  organizationId            String                             @map("organization_id") @db.Uuid
  ownerInvitationId         String                             @map("owner_invitation_id") @db.Uuid
  actorPlatformStaffId      String                             @map("actor_platform_staff_id") @db.Uuid
  action                    OrganizationOwnershipAuditAction
  requestId                 String                             @map("request_id") @db.VarChar(128)
  previousInvitationStatus  OrganizationOwnerInvitationStatus? @map("previous_invitation_status")
  resultingInvitationStatus OrganizationOwnerInvitationStatus  @map("resulting_invitation_status")
  occurredAt                DateTime                           @map("occurred_at") @db.Timestamptz(6)
  recordedAt                DateTime                           @default(now()) @map("recorded_at") @db.Timestamptz(6)
  organization              Organization                       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "organization_ownership_audit_events_organization_fkey")
  ownerInvitation           OrganizationOwnerInvitation        @relation(fields: [organizationId, ownerInvitationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "organization_ownership_audit_events_invitation_fkey")
  actorPlatformStaff        PlatformStaff                      @relation(fields: [actorPlatformStaffId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "organization_ownership_audit_events_actor_fkey")

  @@index([organizationId, ownerInvitationId, recordedAt(sort: Desc), id], map: "organization_ownership_audit_events_org_invitation_time_idx")
  @@index([organizationId, actorPlatformStaffId, recordedAt(sort: Desc), id], map: "organization_ownership_audit_events_org_actor_time_idx")
  @@index([organizationId, action, recordedAt(sort: Desc), id], map: "organization_ownership_audit_events_org_action_time_idx")
  @@index([organizationId, recordedAt(sort: Desc), id], map: "organization_ownership_audit_events_org_time_idx")
  @@index([requestId], map: "organization_ownership_audit_events_request_idx")
  @@map("organization_ownership_audit_events")
}

/// Password material is deliberately separated from public identity data. Values must be hashes
/// produced by an approved application-layer password hashing algorithm, never plaintext.
model PasswordCredential {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique(map: "password_credentials_user_id_key") @map("user_id") @db.Uuid
  passwordHash      String   @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("password_credentials")
}

/// Explicit eligibility for NEXCODE platform administration. Active status alone grants nothing;
/// authorization also requires effective permissions assigned through PlatformRole.
model PlatformStaff {
  id                                 String                                @id @default(uuid()) @db.Uuid
  userId                             String                                @unique(map: "platform_staff_user_id_key") @map("user_id") @db.Uuid
  status                             PlatformStaffStatus
  suspendedAt                        DateTime?                             @map("suspended_at") @db.Timestamptz(6)
  createdAt                          DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                          DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                               User                                  @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  roles                              PlatformStaffRole[]
  adminSessions                      PlatformAdminSession[]
  totpCredential                     PlatformTotpCredential?
  recoveryCodes                      PlatformRecoveryCode[]
  mfaChallenges                      PlatformMfaChallenge[]
  organizationAuditEvents            OrganizationAuditEvent[]
  authorizationAuditEvents           PlatformAuthorizationAuditEvent[]
  ownerInvitationsCreated            OrganizationOwnerInvitation[]
  ownerInvitationDeliveriesRequested OrganizationOwnerInvitationDelivery[]
  ownershipAuditEvents               OrganizationOwnershipAuditEvent[]

  @@index([status], map: "platform_staff_status_idx")
  @@map("platform_staff")
}

/// Server-side NEXCODE administration session. Only a digest of the high-entropy token is stored,
/// and the required MFA timestamp prevents this record from representing a pre-MFA login state.
model PlatformAdminSession {
  id              String        @id @default(uuid()) @db.Uuid
  platformStaffId String        @map("platform_staff_id") @db.Uuid
  tokenDigest     String        @unique(map: "platform_admin_sessions_token_digest_key") @map("token_digest") @db.VarChar(128)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz(6)
  idleExpiresAt   DateTime      @map("idle_expires_at") @db.Timestamptz(6)
  lastSeenAt      DateTime      @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  mfaVerifiedAt   DateTime      @map("mfa_verified_at") @db.Timestamptz(6)
  revokedAt       DateTime?     @map("revoked_at") @db.Timestamptz(6)
  platformStaff   PlatformStaff @relation(fields: [platformStaffId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([platformStaffId, revokedAt, expiresAt], map: "platform_admin_sessions_staff_active_idx")
  @@index([expiresAt], map: "platform_admin_sessions_expires_at_idx")
  @@index([idleExpiresAt], map: "platform_admin_sessions_idle_expires_at_idx")
  @@map("platform_admin_sessions")
}

/// Server-side session for the Organization Portal. It belongs to a global User rather than an
/// Organization because tenant access is authorized from live membership, role and Organization
/// state on every request. Only a purpose-separated digest of the opaque cookie token is persisted.
model OwnerSession {
  id                String                @id(map: "owner_sessions_pkey") @default(uuid()) @db.Uuid
  userId            String                @map("user_id") @db.Uuid
  tokenDigest       String                @unique(map: "owner_sessions_token_digest_key") @map("token_digest") @db.VarChar(128)
  assurance         OwnerSessionAssurance @default(AAL1)
  authenticatedAt   DateTime              @map("authenticated_at") @db.Timestamptz(6)
  mfaVerifiedAt     DateTime?             @map("mfa_verified_at") @db.Timestamptz(6)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  lastActivityAt    DateTime              @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  idleExpiresAt     DateTime              @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime              @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?             @map("revoked_at") @db.Timestamptz(6)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "owner_sessions_user_id_fkey")

  @@index([userId, revokedAt, idleExpiresAt, absoluteExpiresAt], map: "owner_sessions_user_active_idx")
  @@index([idleExpiresAt], map: "owner_sessions_idle_expiry_idx")
  @@index([absoluteExpiresAt], map: "owner_sessions_absolute_expiry_idx")
  @@map("owner_sessions")
}

/// Encrypted TOTP factor for one platform staff identity. Encryption and authenticated-decryption
/// keys remain outside PostgreSQL; the API must atomically advance the accepted time step.
model PlatformTotpCredential {
  id                   String        @id @default(uuid()) @db.Uuid
  platformStaffId      String        @unique(map: "platform_totp_credentials_staff_key") @map("platform_staff_id") @db.Uuid
  encryptedSecret      Bytes         @map("encrypted_secret") @db.ByteA
  encryptionKeyId      String        @map("encryption_key_id") @db.VarChar(120)
  encryptionVersion    Int           @default(1) @map("encryption_version")
  initializationVector Bytes         @map("initialization_vector") @db.ByteA
  authenticationTag    Bytes         @map("authentication_tag") @db.ByteA
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  verifiedAt           DateTime?     @map("verified_at") @db.Timestamptz(6)
  lastUsedAt           DateTime?     @map("last_used_at") @db.Timestamptz(6)
  lastAcceptedTimeStep BigInt?       @map("last_accepted_time_step") @db.BigInt
  disabledAt           DateTime?     @map("disabled_at") @db.Timestamptz(6)
  platformStaff        PlatformStaff @relation(fields: [platformStaffId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("platform_totp_credentials")
}

/// Single-use platform MFA recovery material. The API generates high-entropy codes and stores only
/// their cryptographic digests; consumption must use a conditional atomic update on `usedAt`.
model PlatformRecoveryCode {
  id              String        @id @default(uuid()) @db.Uuid
  platformStaffId String        @map("platform_staff_id") @db.Uuid
  codeDigest      String        @unique(map: "platform_recovery_codes_digest_key") @map("code_digest") @db.VarChar(128)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  usedAt          DateTime?     @map("used_at") @db.Timestamptz(6)
  platformStaff   PlatformStaff @relation(fields: [platformStaffId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([platformStaffId, usedAt], map: "platform_recovery_codes_staff_unused_idx")
  @@map("platform_recovery_codes")
}

/// Short-lived pre-authentication MFA challenge. It grants no platform access and can become a
/// session only through an authorized API flow after expiry, consumption, and attempt checks.
model PlatformMfaChallenge {
  id                String        @id @default(uuid()) @db.Uuid
  platformStaffId   String        @map("platform_staff_id") @db.Uuid
  tokenDigest       String        @unique(map: "platform_mfa_challenges_token_digest_key") @map("token_digest") @db.VarChar(128)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt         DateTime      @map("expires_at") @db.Timestamptz(6)
  consumedAt        DateTime?     @map("consumed_at") @db.Timestamptz(6)
  failedAttempts    Int           @default(0) @map("failed_attempts")
  maxAttempts       Int           @default(5) @map("max_attempts")
  /// Keyed digest scoped to this challenge and verified recipient; never store the plaintext OTP.
  emailOtpDigest    String?       @map("email_otp_digest") @db.VarChar(128)
  emailOtpExpiresAt DateTime?     @map("email_otp_expires_at") @db.Timestamptz(6)
  emailOtpSentAt    DateTime?     @map("email_otp_sent_at") @db.Timestamptz(6)
  emailOtpSendCount Int           @default(0) @map("email_otp_send_count")
  platformStaff     PlatformStaff @relation(fields: [platformStaffId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([platformStaffId, consumedAt, expiresAt], map: "platform_mfa_challenges_staff_active_idx")
  @@index([expiresAt], map: "platform_mfa_challenges_expires_at_idx")
  @@map("platform_mfa_challenges")
}

model PlatformRole {
  id                       String                            @id @default(uuid()) @db.Uuid
  key                      String                            @unique(map: "platform_roles_key_key") @db.Citext
  name                     String                            @db.VarChar(120)
  description              String                            @db.VarChar(500)
  isSystem                 Boolean                           @default(false) @map("is_system")
  createdAt                DateTime                          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                          @updatedAt @map("updated_at") @db.Timestamptz(6)
  staff                    PlatformStaffRole[]
  permissions              PlatformRolePermission[]
  authorizationAuditEvents PlatformAuthorizationAuditEvent[]

  @@map("platform_roles")
}

model PlatformPermission {
  id          String                   @id @default(uuid()) @db.Uuid
  key         String                   @unique(map: "platform_permissions_key_key") @db.Citext
  description String                   @db.VarChar(500)
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles       PlatformRolePermission[]

  @@map("platform_permissions")
}

model PlatformStaffRole {
  platformStaffId String        @map("platform_staff_id") @db.Uuid
  platformRoleId  String        @map("platform_role_id") @db.Uuid
  assignedAt      DateTime      @default(now()) @map("assigned_at") @db.Timestamptz(6)
  platformStaff   PlatformStaff @relation(fields: [platformStaffId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  platformRole    PlatformRole  @relation(fields: [platformRoleId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([platformStaffId, platformRoleId], map: "platform_staff_roles_pkey")
  @@index([platformRoleId], map: "platform_staff_roles_role_id_idx")
  @@map("platform_staff_roles")
}

model PlatformRolePermission {
  platformRoleId       String             @map("platform_role_id") @db.Uuid
  platformPermissionId String             @map("platform_permission_id") @db.Uuid
  grantedAt            DateTime           @default(now()) @map("granted_at") @db.Timestamptz(6)
  platformRole         PlatformRole       @relation(fields: [platformRoleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  platformPermission   PlatformPermission @relation(fields: [platformPermissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([platformRoleId, platformPermissionId], map: "platform_role_permissions_pkey")
  @@index([platformPermissionId], map: "platform_role_permissions_permission_id_idx")
  @@map("platform_role_permissions")
}

/// Successful platform mutations only. SQL checks enforce action-specific metadata; reviewed
/// grants deny routine UPDATE/DELETE. Restrictive references intentionally block parent deletion.
/// A reviewed BEFORE INSERT trigger controls recordedAt even when a writer supplies a value.
model OrganizationAuditEvent {
  id                   String                  @id(map: "organization_audit_events_pkey") @default(uuid()) @db.Uuid
  organizationId       String                  @map("organization_id") @db.Uuid
  actorPlatformStaffId String                  @map("actor_platform_staff_id") @db.Uuid
  requestId            String                  @map("request_id") @db.VarChar(128)
  action               OrganizationAuditAction
  previousStatus       OrganizationStatus?     @map("previous_status")
  resultingStatus      OrganizationStatus      @map("resulting_status")
  changedFields        String[]                @map("changed_fields") @db.VarChar(32)
  previousName         String?                 @map("previous_name") @db.VarChar(160)
  resultingName        String?                 @map("resulting_name") @db.VarChar(160)
  occurredAt           DateTime                @map("occurred_at") @db.Timestamptz(6)
  recordedAt           DateTime                @default(now()) @map("recorded_at") @db.Timestamptz(6)
  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "organization_audit_events_organization_fkey")
  actorPlatformStaff   PlatformStaff           @relation(fields: [actorPlatformStaffId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "organization_audit_events_actor_fkey")

  @@index([organizationId, recordedAt(sort: Desc), id], map: "organization_audit_events_organization_time_idx")
  @@index([actorPlatformStaffId, recordedAt(sort: Desc), id], map: "organization_audit_events_actor_time_idx")
  @@index([recordedAt, id], map: "organization_audit_events_recorded_time_idx")
  @@index([requestId], map: "organization_audit_events_request_idx")
  @@map("organization_audit_events")
}

/// Narrow audit for approved organization-manager provisioning, not arbitrary authorization JSON.
/// The INSERT trigger derives database/operator identities from the actual connection, not input.
/// grantedPermissionKeys is empty only when the exact assignment already exists; no failed grant
/// is recorded as committed success. Role/staff deletion is restricted while history references it.
model PlatformAuthorizationAuditEvent {
  id                     String                            @id(map: "platform_authorization_audit_events_pkey") @default(uuid()) @db.Uuid
  action                 PlatformAuthorizationAuditAction
  targetPlatformStaffId  String                            @map("target_platform_staff_id") @db.Uuid
  targetPlatformRoleId   String                            @map("target_platform_role_id") @db.Uuid
  approvedPermissionKeys String[]                          @map("approved_permission_keys") @db.VarChar(80)
  grantedPermissionKeys  String[]                          @map("granted_permission_keys") @db.VarChar(80)
  operatorSessionRole    String                            @default(dbgenerated("SESSION_USER")) @map("operator_session_role") @db.VarChar(63)
  operatorDatabaseRole   String                            @default(dbgenerated("CURRENT_USER")) @map("operator_database_role") @db.VarChar(63)
  databaseName           String                            @default(dbgenerated("CURRENT_DATABASE()")) @map("database_name") @db.VarChar(63)
  approvalReference      String                            @map("approval_reference") @db.VarChar(120)
  correlationId          String                            @map("correlation_id") @db.Uuid
  outcome                PlatformAuthorizationAuditOutcome
  occurredAt             DateTime                          @map("occurred_at") @db.Timestamptz(6)
  recordedAt             DateTime                          @default(now()) @map("recorded_at") @db.Timestamptz(6)
  targetPlatformStaff    PlatformStaff                     @relation(fields: [targetPlatformStaffId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "platform_authorization_audit_events_staff_fkey")
  targetPlatformRole     PlatformRole                      @relation(fields: [targetPlatformRoleId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "platform_authorization_audit_events_role_fkey")

  @@index([targetPlatformStaffId, recordedAt(sort: Desc), id], map: "platform_authorization_audit_events_staff_time_idx")
  @@index([targetPlatformRoleId, recordedAt(sort: Desc), id], map: "platform_authorization_audit_events_role_time_idx")
  @@index([recordedAt, id], map: "platform_authorization_audit_events_recorded_time_idx")
  @@index([correlationId], map: "platform_authorization_audit_events_correlation_idx")
  @@map("platform_authorization_audit_events")
}
