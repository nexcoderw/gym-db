# test:integration loads .env.local for runtime-target comparisons, then this file.
# Do not override the runtime DATABASE_URL here.
NODE_ENV=test
TEST_DATABASE_URL="postgresql://gym_test:replace-me@localhost:5432/gym_test?sslmode=verify-full"

# UUID matching the human-provisioned database comment:
# nexcode-gym:disposable-integration-test:<uuid>
TEST_DATABASE_MARKER="replace-with-provisioned-uuid"

# Same marked gym_test database, separate append-only role for real permission-denial tests.
# Never use gym_app credentials for gym_dev or production here. This creates no new branch.
TEST_AUDIT_RUNTIME_DATABASE_URL="postgresql://gym_audit_runtime_test:replace-me@localhost:5432/gym_test?sslmode=verify-full"

# Reference-only migration/shadow targets preserve isolation comparisons without DDL credentials.
# Keep host, port, database, and role aligned with .env.migrations.local; omit passwords.
DIRECT_DATABASE_URL="postgresql://gym_migrator@localhost:5432/gym_dev?sslmode=verify-full"
SHADOW_DATABASE_URL="postgresql://gym_migrator@localhost:5432/gym_shadow?sslmode=verify-full"
