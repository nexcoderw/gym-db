# Integration-test process. It loads .env.local first for target comparisons; do not override it.
NODE_ENV=test

# Restricted disposable test database and its human-provisioned safety marker.
TEST_DATABASE_URL="postgresql://gym_test:replace-with-test-password@localhost:5432/gym_test?sslmode=verify-full"
# Generate the marker UUID with: uuidgen | tr '[:upper:]' '[:lower:]'
# The database comment must be: nexcode-gym:disposable-integration-test:<same-uuid>
TEST_DATABASE_MARKER="00000000-0000-4000-8000-000000000000"

# Passwordless reference URLs used only to prove isolation from migration and shadow targets.
DIRECT_DATABASE_URL="postgresql://gym_migrator@localhost:5432/gym_dev?sslmode=verify-full"
SHADOW_DATABASE_URL="postgresql://gym_migrator@localhost:5432/gym_shadow?sslmode=verify-full"
