# test:integration loads .env.local for runtime-target comparisons, then this file.
# Do not override the runtime DATABASE_URL here.
NODE_ENV=test
TEST_DATABASE_URL="postgresql://gym_test:replace-me@localhost:5432/nexcode_gym_test?schema=public"

# UUID matching the human-provisioned database comment:
# nexcode-gym:disposable-integration-test:<uuid>
TEST_DATABASE_MARKER="replace-with-provisioned-uuid"

# Reference-only migration/shadow targets preserve isolation comparisons without DDL credentials.
# Keep host, port, database, and role aligned with .env.migrations.local; omit passwords.
DIRECT_DATABASE_URL="postgresql://gym_migrator@localhost:5432/nexcode_gym?schema=public"
SHADOW_DATABASE_URL="postgresql://gym_migrator@localhost:5432/nexcode_gym_shadow?schema=public"
