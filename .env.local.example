# Runtime connection used by Prisma Client. Never commit a real credential.
DATABASE_URL="postgresql://gym_app:replace-me@localhost:5432/nexcode_gym?schema=public"

# Direct connection used only by the Prisma CLI when runtime traffic uses a pooler.
DIRECT_DATABASE_URL="postgresql://gym_migrator:replace-me@localhost:5432/nexcode_gym?schema=public"

# Optional isolated shadow database for development migration generation. It must not match
# DATABASE_URL or DIRECT_DATABASE_URL and may be reset by Prisma Migrate.
SHADOW_DATABASE_URL="postgresql://gym_migrator:replace-me@localhost:5432/nexcode_gym_shadow?schema=public"

# Restricted DML-only connection used by integration tests after safety verification. It must be
# separate from runtime, migration, shadow, staging, and production databases.
TEST_DATABASE_URL="postgresql://gym_test:replace-me@localhost:5432/nexcode_gym_test?schema=public"

# UUID recorded in the disposable database comment by a human administrator. Generate a unique value
# for each test database and never reuse a marker copied from another database.
TEST_DATABASE_MARKER="00000000-0000-4000-8000-000000000000"

# Direct privileged connection used only to apply reviewed migrations and provision the marker/role.
# Integration tests must never connect with this credential.
TEST_MIGRATION_DATABASE_URL="postgresql://gym_migrator:replace-me@localhost:5432/nexcode_gym_test?schema=public"
