# Human-operated Prisma migration connection. Never load this file into the API or Jest.
DIRECT_DATABASE_URL="postgresql://gym_migrator:replace-with-migration-password@localhost:5432/gym_dev?sslmode=verify-full"

# Isolated shadow database used only while creating migrations; Prisma may reset it.
SHADOW_DATABASE_URL="postgresql://gym_migrator:replace-with-migration-password@localhost:5432/gym_shadow?sslmode=verify-full"

# Disposable migration deployment target. migration:test:deploy does not use the shadow database.
TEST_MIGRATION_DATABASE_URL="postgresql://gym_migrator:replace-with-migration-password@localhost:5432/gym_test?sslmode=verify-full"
