# Human-operated Prisma CLI only. Never load this file into the application or Jest.
# All three databases below live on the development branch, not separate branches.
# DIRECT_DATABASE_URL is sufficient; the duplicate CLI DATABASE_URL is unnecessary.
DIRECT_DATABASE_URL="postgresql://gym_migrator:replace-me@localhost:5432/gym_dev?sslmode=verify-full"

# Isolated scratch database used only by migration:create; Prisma may reset it.
SHADOW_DATABASE_URL="postgresql://gym_migrator:replace-me@localhost:5432/gym_shadow?sslmode=verify-full"

# migration:test:deploy uses only this target, with no shadow database.
TEST_MIGRATION_DATABASE_URL="postgresql://gym_migrator:replace-me@localhost:5432/gym_test?sslmode=verify-full"
