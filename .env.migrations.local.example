# Human-operated Prisma CLI only. Never load this file into the application or Jest.
# DATABASE_URL is a CLI fallback here, not an application-role connection.
DATABASE_URL="postgresql://gym_migrator:replace-me@localhost:5432/nexcode_gym?schema=public"
DIRECT_DATABASE_URL="postgresql://gym_migrator:replace-me@localhost:5432/nexcode_gym?schema=public"

# Isolated scratch database used only by migration:create; Prisma may reset it.
SHADOW_DATABASE_URL="postgresql://gym_migrator:replace-me@localhost:5432/nexcode_gym_shadow?schema=public"

# migration:test:deploy uses only this target, with no shadow database.
TEST_MIGRATION_DATABASE_URL="postgresql://gym_migrator:replace-me@localhost:5432/nexcode_gym_test?schema=public"
